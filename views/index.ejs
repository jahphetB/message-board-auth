<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="stylesheet" href="/styles.css">
		<title><%= title %></title>
	</head>
	<body class="page">
		<main class="main">
			<h1 class="page-title"><%= title %></h1>
			<% if (signedUp) { %>
				<p class="signup-success">Your account has been created.</p>
			<% } %>
			<nav class="account-navigation" aria-label="Account">
				<% if (user) { %>
					<p class="account-name">Signed in as <%= user.username %></p>
					<a class="new-message-link" href="/new">New message</a>
					<% if (!user.is_member) { %>
						<a class="join-club-link home-link" href="/join-club">Join the club</a>
					<% } %>
					<% if (!user.is_admin) { %>
						<a class="become-admin-link home-link" href="/become-admin">Become an admin</a>
					<% } %>
					<form class="logout-form" method="POST" action="/log-out">
						<input class="csrf-token" type="hidden" name="_csrf" value="<%= csrfToken %>">
						<button class="form-submit logout-button" type="submit">Log out</button>
					</form>
				<% } else { %>
					<a class="signup-link home-link" href="/sign-up">Sign up</a>
					<a class="login-link home-link" href="/log-in">Log in</a>
				<% } %>
			</nav>
			<ul class="message-list">
				<% messages.forEach((message) => { %>
					<li class="message-item">
						<h2 class="message-title"><%= message.title %></h2>
						<p class="message-text"><%= message.text %></p>
						<% if (canSeeDetails) { %>
							<p class="message-user"><%= message.first_name %> <%= message.last_name %></p>
							<time class="message-date" datetime="<%= message.created_at.toISOString() %>"><%= message.created_at.toISOString() %></time>
						<% } %>
						<div class="message-actions">
							<a class="message-open-link" href="/messages/<%= message.id %>">Open</a>
							<% if (user && user.is_admin) { %>
								<form class="message-delete-form" method="POST" action="/messages/<%= message.id %>/delete">
									<input class="csrf-token" type="hidden" name="_csrf" value="<%= csrfToken %>">
									<button class="message-delete-button" type="submit">Delete</button>
								</form>
							<% } %>
						</div>
					</li>
				<% }); %>
			</ul>
		</main>
	</body>
</html>
